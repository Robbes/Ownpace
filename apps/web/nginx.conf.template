# Rendered by the nginx image's envsubst entrypoint: ${API_UPSTREAM} is
# substituted from the container environment (only defined env vars are
# substituted, so nginx's own $host/$uri variables survive untouched).

# THE ACCESS LOG, WITHOUT THE SECRETS IN IT. nginx's default log writes each
# request line and its Referer in full, and a grant or view link is a
# credential in the path: the page `/grant/<link>`, the API calls
# `/api/grant/<link>/...` it proxies, and the Referer every one of those calls
# carries. An OAuth callback's query carries a code that can still be spent.
# So a link becomes `:link` and a query is kept only as `?...`, the same rule
# the API's own log follows (`apps/api/src/access-log.ts`). The capture names
# are prefixed so no environment variable can ever be substituted into them.
# The link rules are `~*`, without regard to case, and each letter of a route
# word may be its percent escape (2026-10-05). This server serves the page for
# `/GRANT/<link>` and for `/%67rant/<link>`, and the app's router opens the
# grant page for both: it matches without regard to case, and decodes first.
# It logs `/API/GRANT/<link>` too, when it serves the page for it: only a
# lower-case `/api/` is proxied. The route is written as it came; only the
# link goes.
map $request_uri $ownpace_log_uri_path {
  "~^(?<ownpace_uri_path>[^?]*)\?" "${ownpace_uri_path}?...";
  default $request_uri;
}
map $ownpace_log_uri_path $ownpace_log_uri {
  "~*^(?<ownpace_uri_route>/(?:(?:a|%[46]1)(?:p|%[57]0)(?:i|%[46]9)/)?(?:(?:g|%[46]7)(?:r|%[57]2)(?:a|%[46]1)(?:n|%[46]e)(?:t|%[57]4)|(?:v|%[57]6)(?:i|%[46]9)(?:e|%[46]5)(?:w|%[57]7))/)[^/?]+(?<ownpace_uri_rest>.*)$" "${ownpace_uri_route}:link${ownpace_uri_rest}";
  default $ownpace_log_uri_path;
}
map $http_referer $ownpace_log_referer_path {
  # No Referer at all. Said as an entry of its own because nginx never runs a
  # map's regexes on an empty value, so the "not a URL" rule below cannot.
  "" "-";
  "~^(?<ownpace_referer_path>[^?]*)\?" "${ownpace_referer_path}?...";
  default $http_referer;
}
map $ownpace_log_referer_path $ownpace_log_referer {
  # Anything that is not a URL is written "-", as the API's log does. First,
  # and with `~`: the scheme is read in lower case alone, as it always was,
  # so the caseless link rule below sees only what the API's would.
  "~^(?![a-z][a-z0-9+.-]*://)" "-";
  "~*^(?<ownpace_referer_route>[a-z][a-z0-9+.-]*://[^/]+/(?:(?:a|%[46]1)(?:p|%[57]0)(?:i|%[46]9)/)?(?:(?:g|%[46]7)(?:r|%[57]2)(?:a|%[46]1)(?:n|%[46]e)(?:t|%[57]4)|(?:v|%[57]6)(?:i|%[46]9)(?:e|%[46]5)(?:w|%[57]7))/)[^/?]+(?<ownpace_referer_rest>.*)$" "${ownpace_referer_route}:link${ownpace_referer_rest}";
  default $ownpace_log_referer_path;
}
# nginx's `combined`, with the request line and the Referer in their loggable
# forms: the same fields in the same places.
#
# AND THE VISITOR, LAST, AS A FIELD OF ITS OWN (the owner, 2026-09-28,
# ops-trust-proxy (b): "Keep visitors' addresses in all our logs"; privacy
# §4.5). Behind NetBird, $remote_addr is NetBird's proxy, for every visitor: it
# ends TLS and connects to this machine from its own address on the mesh. The
# visitor's address comes in X-Forwarded-For, which NetBird's proxy sets to the
# address the visitor connected from, dropping whatever the visitor sent
# (netbirdio/netbird at 002755c4, proxy/internal/proxy/reverseproxy.go,
# setUntrustedForwardingHeaders). Recorded here as it arrives, not believed:
# no set_real_ip_from, whose trusted range would be an address written in
# this file. The API reads the same header through TRUST_PROXY (live: 2,
# NetBird and this nginx, which appends NetBird's address below). "-" when a
# request came without one, as one from the machine itself does.
# scripts/a-visitor-every-log-called-netbird.unit.test.ts.
log_format ownpace_combined '$remote_addr - $remote_user [$time_local] '
  '"$request_method $ownpace_log_uri $server_protocol" $status $body_bytes_sent '
  '"$ownpace_log_referer" "$http_user_agent" "$http_x_forwarded_for"';

server {
  listen 80;
  root /usr/share/nginx/html;
  access_log /var/log/nginx/access.log ownpace_combined;

  # Docker's embedded DNS, re-resolved so an api-container restart cannot
  # leave this process holding a stale IP.
  resolver 127.0.0.11 valid=10s ipv6=off;

  # The SPA is built with VITE_API_URL=/api (same origin), so the browser's
  # API calls arrive HERE and must be proxied to the api service — without
  # this block they fell through to the SPA fallback and got index.html back
  # as JSON (the 0011 T7 DRAFT gotcha, resolved 2026-08-10).
  location /api/ {
    # THE LARGEST REPORT THE API TAKES, and not a byte less. A problem report
    # carries its screenshot (up to 5 MB) as base64 inside JSON, and the API
    # parses that route with PROBLEM_REPORT_BODY_LIMIT, '8mb', in
    # apps/api/src/problem-report.ts. Without this line nginx's default of 1 MB
    # answered every screenshot above about 750 KB with its own HTML 413 before
    # the API saw it, and nothing was recorded. Change it with that constant,
    # never below it. On all of /api/ on purpose, not on a location of the
    # report's own: nginx takes the whole body before the API asks who is
    # sending it, so a report location would let the same 8 MB in unsigned,
    # and would be a second proxy block to keep in step with this one. Every
    # other route's parser still refuses more than it allows (100 kB).
    # scripts/a-screenshot-the-front-door-lets-through.unit.test.ts compares
    # this with the location nginx chooses for /api/problem-reports.
    client_max_body_size 8m;
    set $api_upstream http://${API_UPSTREAM};
    proxy_pass $api_upstream;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    # The header NetBird set (the visitor), then the address this request came
    # from (NetBird's): what live's TRUST_PROXY=2 counts back through, so the
    # API names the visitor. $remote_addr here would hand it NetBird's alone,
    # for every visitor. scripts/a-visitor-every-log-called-netbird.unit.test.ts
    # builds the header Express is given from this line.
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_read_timeout 300s;
  }

  # THE WEB APP'S OWN BUILD (workplan 0145): version.json, written by the
  # build beside the page. deploy-live.sh asks it at the app's address and
  # refuses a web app that is not the release's; an open page asks it to learn
  # that a newer one is served. Never from a cache, and a 404 when it is
  # missing, never the page in its place.
  location = /version.json {
    add_header Cache-Control "no-cache" always;
    try_files $uri =404;
  }

  location / { try_files $uri $uri/ /index.html; }
}
