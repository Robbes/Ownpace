{
  "name": "@openmig/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:selfhost": "tsc && vite build --base=/ui/ --outDir dist-selfhost --mode selfhost",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "lint": "eslint src",
    "test": "vitest run"
  },
  "dependencies": {
    "@openmig/shared": "workspace:*",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-query-devtools": "^5.107.1",
    "axios": "^1.21.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.9",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.14.0",
    "jsdom": "^31.0.0",
    "tailwindcss": "^4.3.5",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
