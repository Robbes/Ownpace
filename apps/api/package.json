{
  "name": "@openmig/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "seed:managed": "tsx src/scripts/seed-managed.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mollie/api-client": "^4.6.0",
    "@openmig/connectors": "workspace:*",
    "@openmig/core": "workspace:*",
    "@openmig/ledger": "workspace:*",
    "@openmig/orchestration": "workspace:*",
    "@openmig/scheduler": "workspace:*",
    "@openmig/shared": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.8",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "catalog:",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/morgan": "^1.9.9",
    "@types/node": "^26.2.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
