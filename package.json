{
  "name": "sovereign-migration-stack",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc --noEmit && pnpm --filter @openmig/web typecheck",
    "bench:pglite": "pnpm --filter @openmig/ledger exec tsx ../../scripts/bench-pglite-concurrency.mjs",
    "package:appliance": "pnpm --filter @openmig/web build:selfhost && node scripts/package-appliance.mjs",
    "test": "vitest run --project unit --project unit-browser",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:e2e": "vitest run --project e2e",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@azure/msal-node": "^5.4.3",
    "@trigger.dev/core": "4.5.9",
    "@trigger.dev/sdk": "4.5.9",
    "croner": "^10.0.1",
    "jmap-jam": "^0.13.3"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@eslint/js": "10.0.1",
    "@types/node": "^26.1.2",
    "@types/pg": "catalog:",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "catalog:",
    "esbuild": "^0.28.1",
    "eslint": "10.8.0",
    "imapflow": "^1.6.5",
    "jsdom": "^30.0.1",
    "pg": "catalog:",
    "playwright-core": "^1.62.1",
    "prettier": "3.9.6",
    "supertest": "^7.2.2",
    "testcontainers": "^12.0.4",
    "tsx": "^4",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.10"
  }
}
