{
  "name": "ownpace",
  "version": "0.1.0-rc.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lint": "eslint . --cache --cache-strategy content",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/ui && tsc --noEmit -p site && pnpm --filter @openmig/web typecheck",
    "bench:pglite": "pnpm --filter @openmig/ledger exec node ../../scripts/bench-pglite-concurrency.mjs",
    "package:appliance": "pnpm --filter @openmig/web build:selfhost && node scripts/package-appliance.mjs",
    "test": "vitest run --project unit --project unit-browser",
    "test:integration": "vitest run --project integration --no-file-parallelism",
    "test:e2e": "vitest run --project e2e",
    "test:ui": "vitest run --project ui",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "typecheck:legacy": "tsc6 --noEmit",
    "adr:operative": "node scripts/adr-operative.mjs --write"
  },
  "dependencies": {
    "@azure/msal-node": "^5.6.0",
    "@trigger.dev/core": "4.5.12",
    "@trigger.dev/sdk": "4.5.12",
    "croner": "^10.0.1",
    "jmap-jam": "^0.13.5"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.1",
    "@eslint/js": "10.0.1",
    "@types/node": "^26.4.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pg": "catalog:",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "4.1.11",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "catalog:",
    "esbuild": "^0.28.2",
    "eslint": "10.9.1",
    "imapflow": "^1.7.6",
    "jsdom": "^30.0.1",
    "nodemailer": "^9.0.6",
    "pg": "catalog:",
    "playwright-core": "^1.62.1",
    "supertest": "^7.2.2",
    "testcontainers": "^12.1.0",
    "tsx": "^4.23.12",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.68.0",
    "vitest": "4.1.11",
    "yaml": "^2.9.0"
  }
}
