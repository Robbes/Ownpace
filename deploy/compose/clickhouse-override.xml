<!-- ClickHouse tuning for the managed demo stack (workplan 0018).
     Verbatim from Trigger.dev's own self-hosting reference
     (hosting/docker/clickhouse/override.xml @ v4.5.4): their "official
     recommendations for systems with <16GB RAM". -->
<clickhouse>
    <logger>
        <level>warning</level>
    </logger>
    <mark_cache_size>524288000</mark_cache_size>
    <concurrent_threads_soft_limit_num>1</concurrent_threads_soft_limit_num>
    <profiles>
        <default>
        <max_block_size>8192</max_block_size>
        <max_download_threads>1</max_download_threads>
        <input_format_parallel_parsing>0</input_format_parallel_parsing>
        <output_format_parallel_formatting>0</output_format_parallel_formatting>
        </default>
    </profiles>
</clickhouse>
