# Self-host edition — environment template (workplan 0010 T3/T4).
# Copy to `.env` next to compose.yml (compose auto-loads it):
#   cp deploy/selfhost/selfhost.env.example deploy/selfhost/.env
#   chmod 600 deploy/selfhost/.env
# NEVER commit a filled-in copy. Real secrets belong on the host only (see the
# permissions/rotation guidance in docs/selfhost-quickstart.md).

# ---- Bundled Postgres ----------------------------------------------------
# Single-tenant: the app connects as this owner role (RLS is unused here). The
# DB is only reachable on the internal compose network — it is never published.
POSTGRES_USER=openmigrate
# REQUIRED — compose refuses to start without it. Generate: openssl rand -hex 24
POSTGRES_PASSWORD=
POSTGRES_DB=openmigrate

# ---- Appliance networking ------------------------------------------------
# The status/health endpoint. By default it binds to localhost only; set
# SELFHOST_BIND=0.0.0.0 to expose it on the LAN (behind your own firewall).
SELFHOST_BIND=127.0.0.1
SELFHOST_PORT=8080

# Image tag to run. `edge` is the rolling build; pin to a released version
# tag (e.g. 0.1.0-rc.1) or a digest for production — see "Image channels" in
# deploy/selfhost/README.md. There is no `stable` tag, and `latest` only
# exists once a non-prerelease version has been tagged.
SELFHOST_IMAGE=ghcr.io/robbes/open-migrate-selfhost:edge

# ---- Connection credentials ----------------------------------------------
# Your mapping JSONs reference secrets by ENV VAR NAME (tokenFromEnv /
# passwordFromEnv), never inline. Define those variables here so the app can
# read them at run time. Names are yours to choose — match them in the mapping.
# Examples (uncomment + set to match deploy/selfhost/config/*.json):
#   SOURCE_IMAP_PASSWORD=
#   SOURCE_OAUTH_TOKEN=
#   TARGET_JMAP_PASSWORD=

# ---- Logging -------------------------------------------------------------
# How much the appliance says: error | warn | info | debug. Default: info.
#
#   error  only failures
#   warn   + things that went wrong but did not stop the run (rate limits,
#          retried locks, items the source could not key)
#   info   + the narrative of each run: passes started, totals, per-domain
#          summaries. This is the default and what most operators want.
#   debug  + per-phase timing for every domain, including how much work was
#          actually in flight at once. Turn this on when a migration is
#          slower than expected — it is what tells you whether the time is
#          going to the source, the target, or nowhere at all.
#
# Takes effect on restart: docker compose -f deploy/selfhost/compose.yml up -d
#LOG_LEVEL=info

# --- Notifications (workplan 0030) ----------------------------------------
#
# OFF unless you set these. The appliance says which state it is in at
# startup ("notifications: OFF — ..."), and if you set SOME of them it names
# the ones still missing rather than staying quietly off — a half-configured
# channel is somebody who tried, and silence there would leave you believing
# you are covered.
#
# This is YOUR mail server: the appliance sends through it directly, and
# nothing about notifications reaches a managed service (hard rule 5).
# The password lives here, in this gitignored file, never in a mapping or in
# the repo (hard rule 3).
#
#SMTP_HOST=smtp.your-provider.nl
#SMTP_PORT=587           # default: 587 (STARTTLS), or 465 when SMTP_SECURE=true
#SMTP_SECURE=false       # true = implicit TLS on connect
#SMTP_USER=you@your-domain.nl
#SMTP_PASSWORD=
#NOTIFY_FROM=open-migrate@your-domain.nl
#NOTIFY_TO=you@your-domain.nl        # comma-separated for several people
#NOTIFY_LOCALE=en                    # en | nl — the language YOU read
#
# The "what needs your attention" summary: daily | weekly | both | off.
# Default is daily, at 08:00 local time (weekly goes out Monday 08:00), so a
# summary lands before your day starts rather than at 03:00. `off` keeps the
# immediate events — a decision raised, runs failing, a migration finished —
# and drops only the recap.
#
# A summary with nothing in it is NOT sent. Silence means nothing is waiting;
# a mail that says "all clear" every day teaches you to delete it unread, and
# takes the one that mattered with it. The exception is a queue the appliance
# could not READ: that always sends, naming what it could not look at.
#NOTIFY_DIGEST=daily
