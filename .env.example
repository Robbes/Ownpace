# Ownpace - Environment Configuration
# Copy this file to .env and fill in the values
#
# Minimal template for running apps/api from source. The deployable templates are:
#   managed:   deploy/compose/managed.env.example
#   self-host: deploy/selfhost/selfhost.env.example
# The dev stack (deploy/compose/dev.yml) uses ownpace/ownpace on port 5433.

# ============================================
# Database Configuration
# ============================================
POSTGRES_USER=openmigrate
POSTGRES_PASSWORD=openmigrate_password
POSTGRES_DB=openmigrate
POSTGRES_PORT=5432

# ============================================
# Database roles (RLS enforcement)
# ============================================
# The API/worker connect through the non-owner app_user role via
# APP_DATABASE_URL so row-level security is always enforced; the owner role
# above is for migrations/seeds only (it bypasses RLS as a superuser).
APP_DB_USER=app_user
APP_DB_PASSWORD=app_password

# ============================================
# JWT Authentication
# ============================================
# REQUIRED, no working default (0020 T2): this secret is the tenancy boundary
# and the API refuses to boot in production with a known placeholder.
# Generate: openssl rand -hex 32
JWT_SECRET=
# Managed SSO via JWKS instead of a shared secret: set the issuer (and
# audience) and leave JWT_SECRET unset — JWT_ISSUER takes precedence.
# JWT_ISSUER=
# JWT_AUDIENCE=

# ============================================
# Credential encryption
# ============================================
# Encrypts stored connection credentials (create-mapping + worker). 32 bytes:
# 64 hex chars. Generate: openssl rand -hex 32
# The API and worker MUST share this value; rotating it strands stored secrets.
SECRET_ENCRYPTION_KEY=

# ============================================
# Trigger.dev Configuration
# ============================================
TRIGGER_ENCRYPTION_KEY=your-trigger-encryption-key-min-32-chars
TRIGGER_LOGIN_SECRET=your-trigger-login-secret-min-32-chars
TRIGGER_SECRET_KEY=
TRIGGER_PORT=3090

# ============================================
# Mollie Payment Gateway
# ============================================
# Get this from https://www.mollie.com/dashboard/settings/profile
MOLLIE_API_KEY=your_mollie_api_key

# ============================================
# Application URLs
# ============================================
WEB_URL=http://localhost:3123
API_URL=http://localhost:3001
CORS_ORIGIN=http://localhost:3123

# ============================================
# API Configuration
# ============================================
API_PORT=3001
NODE_ENV=development
