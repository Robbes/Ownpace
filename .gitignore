# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
# The self-host UI bundle (apps/web `build:selfhost`), built into the appliance
# image rather than committed — see ADR-0026.
dist-selfhost/
build/
*.tsbuildinfo

# Environment files
.env
.env.local
.env.*.local
.env.managed

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE
.idea/
.vscode/
*.swp
*.swo

# Test coverage
coverage/
.nyc_output/

# Test logs (durable failure diagnostics)
test-logs/

# smoke-managed.sh's evidence file. SECRET-BEARING: runner debug logs print the
# task's whole environment (DATABASE_URL, SECRET_ENCRYPTION_KEY, the tr_prod_
# key), which is why the workflow redacts a COPY before uploading it and never
# the original. e2e-managed.yml now writes it here instead of /tmp so the
# collector can find it, so it must never become a committable file.
smoke-managed-*.log

# Temporary files
tmp/
temp/
*.tmp

# npm lockfile (pnpm is used instead)
package-lock.json
yarn.lock

# Self-host bundle: real mapping configs are operator-provided and must never be
# shipped as a committed default (the appliance auto-loads every *.json here).
# Only the *.example template is tracked. Test fixtures live under test/e2e/.
deploy/selfhost/config/*.json

# Scratch vitest configs, generated to run a subset of the suite against a local
# Postgres outside the Testcontainers global setup. They hard-code a local
# database and omit the migration step, so one leaking into the repo would be
# actively misleading. `/vitest.config.ts` and `/vitest.global-setup.ts` are the
# real, tracked ones and do NOT match this pattern.
/vitest.*.config.ts

# Container data directories. `test-stalwart-data/config.json` was tracked and
# unignored until 2026-08-13: it carried plaintext dev secrets, bound plaintext
# IMAP on 0.0.0.0:143, and was referenced by nothing. Stalwart writes its state
# into a directory like this on every local run, so the pattern is what stops a
# second one arriving the same way.
*-data/

# PgBouncer credential file — generated by ensure-env-secrets.sh (0082 T4)
deploy/compose/pgbouncer/userlist.txt

# Database dumps taken by hand, at the repo root. Never tracked SQL: the
# migrations live in packages/ledger/migrations/ and are matched by their path,
# not by this. A dump is the whole ledger in plain text — every tenant, every
# mailbox address, every encrypted credential blob — and one appearing as an
# untracked file next to the source is one `git add .` away from being
# published. Seen on the reference box, 2026-08-18.
/*.sql

# ESLint's incremental cache (--cache --cache-strategy content).
# Content-hashed, so it stays valid across a fresh checkout; CI restores it
# with actions/cache. Never committed: it is a local build artifact whose
# entries name absolute paths.
.eslintcache

# Generated by site/build.mjs — regenerate, never commit (workplan 0091 T2).
site/dist/
